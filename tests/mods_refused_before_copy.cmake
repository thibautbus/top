# A game whose profile refuses the mods says so before the save with mods is copied from the vanilla one: a first game
# with mods of Moonrise Regalia (no calls for them) and, with the European ROMs and its English patch there too, of
# Oracles Combined (an image of two games) is refused, and its NAME.mods.sav is not written.  The user's ROMs and patches
# are found by their SHA-1 in ORACLES_ROM_DIR (skipped without them).
#   cmake -D LAUNCHER=the-oracles-project -D WORK=DIR -P mods_refused_before_copy.cmake
set(rom_dir "$ENV{ORACLES_ROM_DIR}")
if(NOT rom_dir OR NOT IS_DIRECTORY "${rom_dir}")
    message("mods refused before copy: ORACLES_ROM_DIR is not set: skipped")
    return()
endif()
file(GLOB files "${rom_dir}/*.gbc" "${rom_dir}/*.bps")
foreach(file IN LISTS files)
    file(SHA1 "${file}" sha1)
    if(sha1 STREQUAL "880374fb978b18af4aa529e2e32f7ffb4d7dd2f4")
        set(ages "${file}")
    elseif(sha1 STREQUAL "fcef50de31ce3e57d3e23cd846c0749e42098e08")
        set(moonrise "${file}")
    elseif(sha1 STREQUAL "9f2dff3c46406839f839a8d535353dfc1e3e8670")
        set(eu_ages "${file}")
    elseif(sha1 STREQUAL "360b9408e569ba826212eac1ebea1b09573cb48c")
        set(eu_seasons "${file}")
    elseif(sha1 STREQUAL "15029267980b902b15f348b89c5f9142f4684051")
        set(combined "${file}")
    endif()
endforeach()
if(NOT ages OR NOT moonrise)
    message("mods refused before copy: no Ages (USA) ROM and Moonrise Regalia patch in ${rom_dir}: skipped")
    return()
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/settings")
file(WRITE "${WORK}/settings/settings.txt" "update_check=off\n")
# A mod without a house: none of the houses' own refusals (a ROM the port does not recognise) comes first.
file(WRITE "${WORK}/talker/main.lua" "mod.npc(\"a\", { existing = { ages = \"3/f8\" } }, function(talk) end)\n")

# A game of `name` (its patch copied into WORK, beside which its saves go) started with a mod, its vanilla save there.
function(expect_refused name reason)
    file(WRITE "${WORK}/${name}.sav" "the vanilla save of ${name}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "ORACLES_SETTINGS_DIR=${WORK}/settings/" SDL_VIDEO_DRIVER=offscreen SDL_AUDIO_DRIVER=dummy
                            "${LAUNCHER}" ${ARGN} --patch "${WORK}/${name}.bps" --mods "${WORK}/talker" --frames 1 --mute --vsync off
                    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(EXISTS "${WORK}/${name}.mods.sav")
        message(FATAL_ERROR "${name} with a mod: ${name}.mods.sav copied from ${name}.sav, the game not refused first\n${err}")
    endif()
    string(FIND "${err}" "${reason}" at)
    if(status EQUAL 0 OR at LESS 0)
        message(FATAL_ERROR "${name} with a mod: not refused for \"${reason}\" (${status})\n${err}")
    endif()
    file(READ "${WORK}/${name}.sav" vanilla)
    if(NOT vanilla STREQUAL "the vanilla save of ${name}\n")
        message(FATAL_ERROR "${name} with a mod: the vanilla save changed")
    endif()
endfunction()

configure_file("${moonrise}" "${WORK}/moonrise.bps" COPYONLY)
expect_refused(moonrise "the game's calls cannot be armed" --rom "${ages}")
message("mods refused before copy: Moonrise Regalia refuses a mod, its save with mods not copied")
if(NOT eu_ages OR NOT eu_seasons OR NOT combined)
    message("mods refused before copy: no European ROMs of Ages and Seasons and English patch of Oracles Combined 1.5 in ${rom_dir}: Oracles Combined not checked")
    return()
endif()
configure_file("${combined}" "${WORK}/combined.bps" COPYONLY)
expect_refused(combined "an image of two games plays without mods" --rom "${eu_ages}" --joined-rom "${eu_seasons}")
message("mods refused before copy: Oracles Combined refuses a mod, its save with mods not copied")
